{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "vitest.config.ts",
    "tsconfig.base.json",
    "pnpm-lock.yaml",
    "tests/setup/**",
    "eslint.config.js"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["src/**", "tests/**", "drizzle/**", "package.json", "tsconfig.json"],
      "outputs": ["trace-report.json"]
    },
    "@odudu/db#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/*/src/schema/**"
      ],
      "outputs": ["trace-report.json"]
    },
    "@odudu/protocol-oidc#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/*/src/view/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/tests/lint/fixtures/renderer-without-shell/**"
      ],
      "outputs": ["trace-report.json"]
    },
    "@odudu/server#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/packages/console-gateway/tests/fixtures/**"
      ],
      "outputs": ["trace-report.json"]
    },
    "@odudu/console-gateway#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/apps/admin-console/package.json"
      ],
      "outputs": ["trace-report.json"]
    },
    "@odudu/instrument#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "src/**",
        "tests/**",
        "drizzle/**",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/apps/admin-console/src/shared/view/*.css"
      ],
      "outputs": ["trace-report.json"]
    },
    "@odudu/instrument#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "package.json",
        "$TURBO_ROOT$/apps/admin-console/src/shared/view/*.css"
      ],
      "outputs": ["dist/**"]
    },
    "@odudu/docs#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "content/**",
        "src/**",
        "static/**",
        "plugins/**",
        "nav.ts",
        "sidebars.ts",
        "site.config.ts",
        "docusaurus.config.ts",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/apps/admin-console/src/shared/view/*.css"
      ],
      "env": ["DOCS_SITE_ORIGIN", "DOCS_BASE"],
      "outputs": ["dist/**"]
    },
    "@odudu/docs#test": {
      "dependsOn": ["^typecheck", "@odudu/docs#build"],
      "inputs": [
        "content/**",
        "src/**",
        "static/**",
        "plugins/**",
        "nav.ts",
        "sidebars.ts",
        "site.config.ts",
        "docusaurus.config.ts",
        "package.json",
        "tsconfig.json",
        "$TURBO_ROOT$/apps/admin-console/src/shared/view/*.css",
        "tests/**"
      ],
      "outputs": ["trace-report.json"]
    },
    "@odudu/repo-checks#test": {
      "cache": false,
      "dependsOn": ["^typecheck", "@odudu/admin-console#build"]
    }
  }
}
