# Copy to .env beside compose.yaml, or export these before `docker compose up`.

# The first administrator's address; also the name they sign in with.
# Without one, and with no terminal, the address is admin@odudu.local.
ODUDU_ADMIN_EMAIL=you@example.com

# Leave blank to be given a one-time password in `docker compose logs setup`,
# or set one here (at least 8 characters). It is never printed. Compose reads
# this file itself: in single quotes the value is taken exactly as written,
# without them a $ starts a variable and a # starts a comment, and the
# password you then have is not the one you typed. Use single quotes, like
#   ODUDU_ADMIN_PASSWORD='pa$sw0rd #1'
# or export the variable in your shell instead.
ODUDU_ADMIN_PASSWORD=

# The host port the server is published on, loopback only; a number from 1
# to 65535. The public base URL
# follows it, so a passkey or a mailed link points at the right address.
ODUDU_PORT=3000

# Use another build of the image, for example one made from a checkout.
# ODUDU_IMAGE=ghcr.io/wizzywit/odudu:0.0.0
