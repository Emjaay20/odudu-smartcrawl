{
  "name": "@odudu/email",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "scripts": {
    "generate": "node scripts/generate-assets.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts --reporter=default --reporter=json --outputFile=trace-report.json",
    "preview": "node scripts/preview.ts"
  },
  "dependencies": {
    "@odudu/contracts": "workspace:*",
    "@odudu/db": "workspace:*",
    "@odudu/i18n": "workspace:*",
    "@odudu/kernel": "workspace:*",
    "drizzle-orm": "0.45.4",
    "nodemailer": "10.1.7"
  },
  "devDependencies": {
    "@odudu/testkit": "workspace:*",
    "@types/nodemailer": "8.0.2",
    "testcontainers": "12.2.1",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
